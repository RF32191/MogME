# Server
PORT=8787

# AI rizz round (optional in dev — falls back to a heuristic if unset)
OPENAI_API_KEY=
RIZZ_MODEL=gpt-4o-mini

# Moderation (REQUIRED before production for user-to-user content)
MODERATION_ENABLED=false
MODERATION_PROVIDER=stub   # stub | openai | hive | sightengine

# Round tuning (ms)
FACE_ROUND_TIMEOUT_MS=60000
COGNITION_ROUND_MS=45000
COGNITION_QUESTION_COUNT=5
RIZZ_ROUND_MS=120000
RIZZ_MAX_TURNS=12
RIZZ_WIN_THRESHOLD=100

# Matchmaking
MATCHMAKING_TIER_BAND=200
MATCHMAKING_MAX_WAIT_MS=15000

# ELO
ELO_K=32
ELO_START=1000

# Uploaded distorted-image retention (ms)
IMAGE_RETENTION_MS=300000
